        "systemVersion": "5.3.28"
      }
    },
    {
      "_id": "BEbpaZn17NogiwCi",
      "_key": "!journal.pages!gRfqeOIXEHOcLemr.BEbpaZn17NogiwCi",
      "name": "Conexión con la coterie",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>El Expediente tiene una tabla de Helen con quince informes forenses &quot;imposibles&quot;. Todos llevan la firma de Ruth.</p>\n"
      },
      "sort": 400000,
      "ownership": {
        "default": 2
      },
      "flags": {
