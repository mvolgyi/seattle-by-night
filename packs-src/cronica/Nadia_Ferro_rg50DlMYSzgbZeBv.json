      }
    },
    {
      "_id": "eo127FgRSfKBRhdT",
      "_key": "!journal.pages!rg50DlMYSzgbZeBv.eo127FgRSfKBRhdT",
      "name": "Conexión con la coterie",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>El Expediente tiene una nota de Helen sobre su propia productora: «N. nunca aparece en las fotos de grupo. ¿Casualidad?».</p>\n"
      },
      "sort": 400000,
      "ownership": {
        "default": 2
      },
