    {
      "_id": "tSCe3zZnVyKF3RS5",
      "_key": "!journal.pages!ciIKIq7hoVokkr0J.tSCe3zZnVyKF3RS5",
      "name": "Read Aloud",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<section class=\"sbn-leer\"><p>A black door with no sign on a street full of bars. Inside, an exposed-brick basement with a small stage and a crowd that dances with their eyes closed. The music is slow and low, with a bass line that gets inside your chest. Under the red lights, everyone looks a little paler than they should. Someone at the bar is writing on a napkin.</p>\n</section>\n"
      },
      "sort": 200000,
      "ownership": {
        "default": 2
      },
