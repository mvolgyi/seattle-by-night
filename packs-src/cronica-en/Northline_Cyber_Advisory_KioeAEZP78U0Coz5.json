    {
      "_id": "VWCt5iDLvLGJ3bCi",
      "_key": "!journal.pages!KioeAEZP78U0Coz5.VWCt5iDLvLGJ3bCi",
      "name": "Read Aloud",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<section class=\"sbn-leer\"><p>An office like any other in South Lake Union: gray carpet, plastic plants, standing desks, a welcome sign with the logo of a cybersecurity consultancy. At three in the morning, three lights are on on the 11th floor. One of them belongs to a conference room with the blinds drawn.</p>\n</section>\n"
      },
      "sort": 200000,
      "ownership": {
        "default": 2
      },
