      }
    },
    {
      "_id": "GCQxsXXb53VcQOQ0",
      "_key": "!journal.pages!zQMt8VMfKPoL6INq.GCQxsXXb53VcQOQ0",
      "name": "Ambition, Desire, and Touchstone",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p><strong>Ambition:</strong> for her name to be worth more than her sire&#39;s. <strong>Desire:</strong> for Halloway to recognize her as his equal. <strong>Suggested Conviction:</strong> “Never let anyone fall alone.” <strong>Touchstone:</strong> her mother, who lives in a care home with dementia and still calls her by her name.</p>\n"
      },
      "sort": 500000,
