    {
      "_id": "ZdrLxATZwHCvciKA",
      "_key": "!journal.pages!rg50DlMYSzgbZeBv.ZdrLxATZwHCvciKA",
      "name": "Ambition, Desire, and Touchstone",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p><strong>Ambition:</strong> record something that outlives the Masquerade. <strong>Desire:</strong> for Helen to finish her big story. <strong>Suggested Conviction:</strong> “Never silence someone who tells the truth.” <strong>Touchstone:</strong> Theo, her old bandmate, who still plays Thursdays at a dive bar on Capitol Hill.</p>\n"
      },
