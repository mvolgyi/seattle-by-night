    },
    {
      "_id": "eo127FgRSfKBRhdT",
      "_key": "!journal.pages!rg50DlMYSzgbZeBv.eo127FgRSfKBRhdT",
      "name": "Connection to the Coterie",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>The File has a note from Helen about her own producer: “N. never shows up in group photos. Coincidence?”</p>\n"
      },
