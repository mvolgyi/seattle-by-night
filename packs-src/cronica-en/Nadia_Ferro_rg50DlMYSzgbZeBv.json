        "systemVersion": "5.3.28"
      }
    },
    {
      "_id": "XXjWUGWhEvABocZ8",
      "_key": "!journal.pages!rg50DlMYSzgbZeBv.XXjWUGWhEvABocZ8",
      "name": "Kindred Nights",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>Prince Marcus Whitmore (@UUID[JournalEntry.sCVTjJFrnyyVnQDt]{Marcus Whitmore}) heard her mixing live at a club and Embraced her in 2016. To him she was one more piece in his collection. She lives at court, but she doesn&#39;t belong to him. In 2021 she started producing “What the City Forgets,” Helen&#39;s podcast. Helen&#39;s voice hooked her. Ever since, she has been passing Helen anonymous tips to make the episodes better. She feeds at late-night shows, on audiences lost in a trance.</p>\n"
      },
      "sort": 300000,
      "ownership": {
        "default": 2
      },
      "flags": {
