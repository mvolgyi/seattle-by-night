    {
      "_id": "BQPpOLqqyVa9mhVI",
      "_key": "!journal.pages!zSkwEUUtkNGhfXun.BQPpOLqqyVa9mhVI",
      "name": "Read Aloud",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<section class=\"sbn-leer\"><p>The campus is an office park with artificial turf and benches nobody uses. In the lobby, a giant screen shows a mosaic of thousands of live doorbell feeds: porches, hallways, rain. Below it, the company motto: “We see what the city doesn&#39;t.” The building out back has no windows. It hums.</p>\n</section>\n"
      },
      "sort": 200000,
      "ownership": {
        "default": 2
      },
      "flags": {
        "seattle-by-night": {
          "origen": "pagina"
        }
      },
      "_stats": {
        "coreVersion": "14.365",
