    {
      "_id": "9sAvV20wWVFykVwf",
      "_key": "!journal.pages!gRfqeOIXEHOcLemr.9sAvV20wWVFykVwf",
      "name": "Ambition, Desire, and Touchstone",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p><strong>Ambition:</strong> find the body that disappeared in 2004. <strong>Desire:</strong> one night without corpses. <strong>Suggested Conviction:</strong> “The dead deserve the truth, even if the living don&#39;t.” <strong>Touchstone:</strong> her ex-husband, a retired homicide detective who still calls her when he can&#39;t sleep.</p>\n"
      },
