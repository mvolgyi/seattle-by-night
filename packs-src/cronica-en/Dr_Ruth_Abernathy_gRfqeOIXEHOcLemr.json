    },
    {
      "_id": "BEbpaZn17NogiwCi",
      "_key": "!journal.pages!gRfqeOIXEHOcLemr.BEbpaZn17NogiwCi",
      "name": "Connection to the Coterie",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>The File holds a table of Helen&#39;s listing fifteen “impossible” autopsy reports. Every one of them bears Ruth&#39;s signature.</p>\n"
      },
      "sort": 400000,
      "ownership": {
        "default": 2
