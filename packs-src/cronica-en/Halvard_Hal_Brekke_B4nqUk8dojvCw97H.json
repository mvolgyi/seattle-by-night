    },
    {
      "_id": "LCm3ydL6Sb9Y0pVe",
      "_key": "!journal.pages!B4nqUk8dojvCw97H.LCm3ydL6Sb9Y0pVe",
      "name": "Ambition, Desire, and Touchstone",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p><strong>Ambition:</strong> earn a domain of his own. <strong>Desire:</strong> to hear Montgomery tell him, just once, that he did well. <strong>Suggested Conviction:</strong> “Leave no one in the water.” <strong>Touchstone:</strong> his niece Ingrid, who captains the family boat today and saves him a seat at the Christmas table even though he never comes.</p>\n"
      },
