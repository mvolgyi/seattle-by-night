      },
      "text": {
        "format": 1,
        "content": "<img class=\"sbn-retrato\" src=\"modules/seattle-by-night/assets/retratos/PJ-05.webp\" alt=\"Halvard “Hal” Brekke\">\n<p class=\"sbn-enlace-actor\"><i class=\"fa-solid fa-user\"></i> Sheet: @UUID[Actor.doLuya2qqzFb2wqn]{Halvard Brekke}</p>\n<p><strong>Concept:</strong> former crab fisherman, childe of Sheriff Montgomery, and member of his pack.</p>\n"
      },
      "sort": 100000,
      "ownership": {
        "default": 2
      },
      "flags": {
