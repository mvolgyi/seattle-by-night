      "name": "Read Aloud",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<section class=\"sbn-leer\"><p>A plain gray granite headstone on a hillside of cedars. EMILY ROSE SMITH · 1958–1996 · “She stayed with the ones nobody wanted.” The grass is trimmed. At the foot of the stone lies a bunch of fresh flowers, wrapped in newspaper, still beaded with rain.</p>\n</section>\n"
      },
