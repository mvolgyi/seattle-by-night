      "text": {
        "format": 1,
        "content": "<img class=\"sbn-retrato\" src=\"modules/seattle-by-night/assets/retratos/PJ-03.webp\" alt=\"Ezra “Static” Lund\">\n<p class=\"sbn-enlace-actor\"><i class=\"fa-solid fa-user\"></i> Sheet: @UUID[Actor.zGqiDTb68QRTrlLv]{Ezra Lund}</p>\n<p><strong>Concept:</strong> network security engineer, Embraced by the Underground&#39;s information broker.</p>\n"
      },
