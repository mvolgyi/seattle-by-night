      }
    },
    {
      "_id": "iriioV5GwQJ2mHGH",
      "_key": "!journal.pages!PBJeE9T9n0BjB6ag.iriioV5GwQJ2mHGH",
      "name": "Ambition, Desire, and Touchstone",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p><strong>Ambition:</strong> expose whoever controls the city&#39;s cameras. <strong>Desire:</strong> for someone to see his face and not look away. <strong>Suggested Conviction:</strong> “Information belongs to whoever needs it, not whoever pays for it.” <strong>Touchstone:</strong> his sister Maja, a night-shift nurse, who leaves food at his door even though she knows he doesn&#39;t eat it.</p>\n"
      },
      "sort": 500000,
      "ownership": {
