      }
    },
    {
      "_id": "aHqQRNBH7lu6TW0q",
      "_key": "!journal.pages!PBJeE9T9n0BjB6ag.aHqQRNBH7lu6TW0q",
      "name": "Connection to the Coterie",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>The File has a thermal camera capture showing a figure with no body heat going into a manhole in Pioneer Square. It&#39;s him.</p>\n"
      },
      "sort": 400000,
      "ownership": {
        "default": 2
      },
      "flags": {
