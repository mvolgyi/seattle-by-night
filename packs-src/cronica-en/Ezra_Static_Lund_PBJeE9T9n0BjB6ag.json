    },
    {
      "_id": "skUGDINgstBDquGH",
      "_key": "!journal.pages!PBJeE9T9n0BjB6ag.skUGDINgstBDquGH",
      "name": "Suggested Backgrounds",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<p>Contacts (hackers) 2, Herd 1, Haven 2 (in the Underground), Mawla (Thornquist) 1. Advantage: feed from bags without penalty.</p>\n"
      },
