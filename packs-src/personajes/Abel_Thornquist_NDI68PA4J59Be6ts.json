      "concept": "Primogénito Nosferatu",
      "chronicle": "Seattle by Night",
      "ambition": "Que nadie pueda gobernar Seattle sin pasar por abajo.",
      "desire": "",
      "touchstones": "<h3>Convicciones</h3><ul><li>Un trato es un trato</li><li>Lo que se entierra no se pierde</li></ul><h3>Piedras de toque</h3><ul><li><strong>Dee Watkins</strong>: Trabajadora de un albergue de Pioneer Square, que deja la puerta trasera abierta para «los de abajo» y nunca hace preguntas.</li></ul>",
      "sire": "«La Madre de Abajo»",
      "generation": "9"
    },
