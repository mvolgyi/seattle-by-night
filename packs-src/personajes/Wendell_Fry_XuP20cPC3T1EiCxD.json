    "headers": {
      "concept": "Primogénito Malkavian (por costumbre)",
      "chronicle": "Seattle by Night",
      "ambition": "Descifrar lo que la ciudad intenta decirle.",
      "desire": "",
      "touchstones": "<h3>Convicciones</h3><ul><li>Nunca interrumpir a alguien que dice la verdad</li></ul><h3>Piedras de toque</h3><ul><li><strong>Helen Ward (PNJ-04)</strong>: Aunque ella no lo sabe.</li></ul>",
      "sire": "Una Malkavian sin nombre que llamaba desde Fremont",
      "generation": "10"
    },
    "bio": {
      "age": {
        "trueage": "",
        "apparent": ""
