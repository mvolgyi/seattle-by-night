      "text": {
        "format": 1,
        "content": "<div class=\"sbn-doc sbn-doc-tarjeta\"><div class=\"sbn-pantalla\"><p class=\"sbn-acotacion\">[ SCREEN ]</p>\n<p>CONTACTS</p>\n<hr class=\"sbn-pantalla-raya\">\n<p>▶ SAFE</p>\n<hr class=\"sbn-pantalla-raya\">\n<p>1 contact</p>\n\n<p class=\"sbn-pantalla-estado\">[Battery: ▮▮▮▯ · Last charged: Sunday]</p>\n</div><aside class=\"sbn-manuscrito sbn-manuscrito-cinta\"><p class=\"sbn-acotacion\">[Turning the phone over, on the lid, a strip of painter&#39;s tape:]</p>\n<p>NOT FOR THE POLICE.</p>\n<p>NOT FOR THE PODCAST.</p></aside></div>"
