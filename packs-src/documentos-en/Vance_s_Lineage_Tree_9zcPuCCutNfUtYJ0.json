      "name": "Vance's Lineage Tree",
      "type": "text",
      "title": {
        "show": false,
        "level": 1
      },
      "text": {
        "format": 1,
        "content": "<div class=\"sbn-doc sbn-doc-diagrama\"><p class=\"sbn-doc-titulo\">LINEAGE OF MARCUS “IRONJAW” VANCE</p>\n<p><em>Brujah · Camarilla · Doctrine of Controlled Fury</em></p>\n<p>Unnamed Brujah veteran</p>\n<p class=\"sbn-diagrama-conector\">│</p>\n<p><em>Berlin, 1945</em></p>\n<p class=\"sbn-diagrama-conector\">│</p>\n<p class=\"sbn-doc-titulo\">MARCUS VANCE</p>\n<p><em>8th Generation · disappeared in 1985, near Cluj-Napoca</em></p>\n<p class=\"sbn-diagrama-conector\">│</p>\n<table class=\"sbn-tabla sbn-doc-tabla sbn-diagrama-tabla\">\n<thead>\n<tr>\n<th>┌───────────</th>\n<th>───────────┐</th>\n</tr>\n</thead>\n<tbody><tr>\n<td><em>Haiti, 1960</em><br><strong>DAVID SMITH</strong><br>9th Generation<br>“The American”<br>Finished the lesson<br>Full guard</td>\n<td><em>Marseille, 1972</em><br><strong>AUGUST KRELL</strong><br>9th Generation<br>“The German”<br>Abandoned in 1976<br>Inverted guard</td>\n</tr>\n</tbody></table>\n<p><em>“If the American and the German ever meet, let the American teach him the other guard.”</em></p>\n<p class=\"sbn-firma\">— Journal of M. V., folio 42</p>\n</div>"
      },
