  "system": {
    "group": "HreoEGHHF8fvUBHd",
    "headers": {
      "concept": "FIRSTLIGHT tactical team breacher, former Army combat engineer",
      "chronicle": "The Ward File",
      "ambition": "Retire with the house paid off before forty-five.",
      "desire": "One night on the job without anyone saying “subject.”",
      "touchstones": "<h3>Touchstones</h3><ul><li>Her mother, in the house in Ballard, four blocks from Market Street.</li></ul>",
      "sire": "",
      "generation": "",
      "creedfields": "Building, inventing, augmenting or repairing during the Hunt.",
