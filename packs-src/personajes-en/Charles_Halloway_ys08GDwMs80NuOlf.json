    "headers": {
      "concept": "Ventrue Primogen",
      "chronicle": "The Ward File",
      "ambition": "The crown of Seattle.",
      "desire": "",
      "touchstones": "<h3>Convictions</h3><ul><li>Order is a service, not a privilege</li><li>Never let them see you get your hands dirty</li></ul><h3>Touchstones</h3><ul><li><strong>Margaret Halloway</strong>: His 22-year-old grandniece, a journalism student, who believes her great-uncle is the anonymous benefactor behind her scholarship.</li></ul>",
      "sire": "Adelaide Grange (PNJ-22)",
