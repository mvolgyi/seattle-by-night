    "group": "",
    "headers": {
      "concept": "Antagonist; the false Vance",
      "chronicle": "The Ward File",
      "ambition": "For someone to acknowledge that he was Vance's son too.",
      "desire": "",
      "touchstones": "<h3>Convictions</h3><ul><li>A job gets finished</li><li>Never hit someone who can&#39;t hit back</li></ul>",
      "sire": "Marcus “Ironjaw” Vance (PNJ-06)",
