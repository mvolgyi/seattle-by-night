    "group": "",
    "headers": {
      "concept": "Prince of Seattle",
      "chronicle": "The Ward File",
      "ambition": "For his reign to be remembered as a golden age.",
      "desire": "",
      "touchstones": "<h3>Convictions</h3><ul><li>Beauty justifies almost anything</li></ul><h3>Touchstones</h3><ul><li><strong>Ruby Kessler</strong>: 81, a former dancer whose scholarship he funded in the &#39;60s and who now lives in a nursing home. He still sends her flowers.</li></ul>",
      "sire": "Clémence Aubert, a soprano with the San Francisco Opera",
      "generation": "8"
    },
