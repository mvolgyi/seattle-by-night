  "system": {
    "group": "HreoEGHHF8fvUBHd",
    "headers": {
      "concept": "FIRSTLIGHT, head of the Puget Cell; latent antagonist",
      "chronicle": "The Ward File",
      "ambition": "Get the national office to send reinforcements and tear Seattle's structure out by the roots.",
      "desire": "Find out what ARCHER wants before the next delivery.",
      "touchstones": "<h3>Touchstones</h3><ul><li>Her mother, the schoolteacher from Louisiana, now retired. Okafor calls her on Sundays and tells her the job is boring.</li></ul>",
      "sire": "",
      "generation": "",
      "creedfields": "Gaining information during the Hunt: research, breaking and entering, and interrogation.",
      "cellname": "Puget Cell"
    },
    "bio": {
      "age": {
