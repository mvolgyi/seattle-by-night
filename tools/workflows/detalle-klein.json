{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "FLUX.2 [klein] 4B destilado" },
    "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3 4B (flux2)" },
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": { "title": "Mosaico a repintar (ya al tamaño de salida, múltiplo de 16)" },
    "inputs": { "image": "{{IMAGEN}}" }
  },
  "5": {
    "class_type": "ImageScale",
    "inputs": { "image": ["4", 0], "upscale_method": "lanczos", "width": "{{ANCHO}}", "height": "{{ALTO}}", "crop": "disabled" }
  },
  "6": {
    "class_type": "VAEEncode",
    "_meta": { "title": "Latente del mosaico: referencia Y punto de partida" },
    "inputs": { "pixels": ["5", 0], "vae": ["3", 0] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" }
  },
  "8": {
    "class_type": "ReferenceLatent",
    "_meta": { "title": "Referencia: el mismo mosaico" },
    "inputs": { "conditioning": ["7", 0], "latent": ["6", 0] }
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["8", 0] }
  },
  "10": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{{SEMILLA}}" }
  },
  "11": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "12": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": "{{PASOS}}", "width": "{{ANCHO}}", "height": "{{ALTO}}" }
  },
  "13": {
    "class_type": "SplitSigmasDenoise",
    "_meta": { "title": "DENOISE: sólo los últimos pasos (img2img)" },
    "inputs": { "sigmas": ["12", 0], "denoise": "{{DENOISE}}" }
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["10", 0], "guider": ["9", 0], "sampler": ["11", 0], "sigmas": ["13", 1], "latent_image": ["6", 0] }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["14", 0], "vae": ["3", 0] }
  },
  "16": {
    "class_type": "SaveImage",
    "_meta": { "title": "Salida" },
    "inputs": { "images": ["15", 0], "filename_prefix": "{{PREFIJO}}" }
  }
}
