{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Qwen-Image-Edit-2511 GGUF Q5_K_M (alternativa: qwen-image-edit-2511-Q4_K_M.gguf)" },
    "inputs": { "unet_name": "qwen-image-edit-2511-Q5_K_M.gguf" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Lightning 4 pasos (strength 0 + steps 20 + cfg 4 para desactivarlo)" },
    "inputs": { "model": ["1", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1 }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["2", 0], "shift": 3.1 }
  },
  "4": {
    "class_type": "CFGNorm",
    "inputs": { "model": ["3", 0], "strength": 1 }
  },
  "5": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen2.5-VL 7B fp8" },
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "Imagen 1: esquema / imagen a editar" },
    "inputs": { "image": "{{IMAGEN}}" }
  },
  "8": {
    "class_type": "LoadImage",
    "_meta": { "title": "Imagen 2: referencia de estilo" },
    "inputs": { "image": "{{IMAGEN_ESTILO}}" }
  },
  "9": {
    "class_type": "ImageScale",
    "_meta": { "title": "Imagen 1 al tamaño de salida" },
    "inputs": { "image": ["7", 0], "upscale_method": "lanczos", "width": "{{ANCHO}}", "height": "{{ALTO}}", "crop": "disabled" }
  },
  "10": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Prompt (Picture 1 = esquema, Picture 2 = estilo)" },
    "inputs": { "clip": ["5", 0], "prompt": "{{PROMPT}}", "vae": ["6", 0], "image1": ["9", 0], "image2": ["8", 0] }
  },
  "11": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Negativo" },
    "inputs": { "clip": ["5", 0], "prompt": "", "vae": ["6", 0], "image1": ["9", 0], "image2": ["8", 0] }
  },
  "12": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["10", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "13": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["11", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "14": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "Tamaño" },
    "inputs": { "width": "{{ANCHO}}", "height": "{{ALTO}}", "batch_size": 1 }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0], "positive": ["12", 0], "negative": ["13", 0], "latent_image": ["14", 0],
      "seed": "{{SEMILLA}}", "steps": 4, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "denoise": 1
    }
  },
  "16": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["15", 0], "vae": ["6", 0] }
  },
  "17": {
    "class_type": "SaveImage",
    "_meta": { "title": "Salida" },
    "inputs": { "images": ["16", 0], "filename_prefix": "{{PREFIJO}}" }
  }
}
