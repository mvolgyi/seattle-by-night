{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Qwen-Image-Edit-2511 GGUF Q5_K_M" },
    "inputs": { "unet_name": "qwen-image-edit-2511-Q5_K_M.gguf" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Lightning 4 pasos (LORA 1 + PASOS 4 + CFG 1; sin Lightning: LORA 0 + PASOS 20 + CFG 4)" },
    "inputs": { "model": ["1", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": "{{LORA}}" }
  },
  "3": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["2", 0], "shift": 3.1 }
  },
  "4": {
    "class_type": "CFGNorm",
    "inputs": { "model": ["3", 0], "strength": 1 }
  },
  "5": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen2.5-VL 7B fp8" },
    "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default" }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "Esquema del plano (lienzo ya en la proporción de salida)" },
    "inputs": { "image": "{{IMAGEN}}" }
  },
  "8": {
    "class_type": "ImageScale",
    "_meta": { "title": "Esquema al tamaño de salida" },
    "inputs": { "image": ["7", 0], "upscale_method": "lanczos", "width": "{{ANCHO}}", "height": "{{ALTO}}", "crop": "disabled" }
  },
  "9": {
    "class_type": "VAEEncode",
    "_meta": { "title": "Latente del esquema: referencia Y punto de partida (DENOISE < 1 = img2img)" },
    "inputs": { "pixels": ["8", 0], "vae": ["6", 0] }
  },
  "10": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Prompt (sin VAE: la referencia va por ReferenceLatent al tamaño exacto de salida)" },
    "inputs": { "clip": ["5", 0], "prompt": "{{PROMPT}}", "image1": ["8", 0] }
  },
  "11": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "Negativo (sólo pesa con CFG > 1)" },
    "inputs": { "clip": ["5", 0], "prompt": "{{NEGATIVO}}", "image1": ["8", 0] }
  },
  "12": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["10", 0], "latent": ["9", 0] }
  },
  "13": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["11", 0], "latent": ["9", 0] }
  },
  "14": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["12", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "15": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["13", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "16": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0], "positive": ["14", 0], "negative": ["15", 0], "latent_image": ["9", 0],
      "seed": "{{SEMILLA}}", "steps": "{{PASOS}}", "cfg": "{{CFG}}", "sampler_name": "euler", "scheduler": "simple", "denoise": "{{DENOISE}}"
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["16", 0], "vae": ["6", 0] }
  },
  "18": {
    "class_type": "SaveImage",
    "_meta": { "title": "Salida" },
    "inputs": { "images": ["17", 0], "filename_prefix": "{{PREFIJO}}" }
  }
}
