{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "FLUX.2 [klein] 4B destilado (4 pasos)" },
    "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3 4B (flux2)" },
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": { "title": "Imagen 1: esquema / imagen a editar" },
    "inputs": { "image": "{{IMAGEN}}" }
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": { "title": "Imagen 2: referencia de estilo" },
    "inputs": { "image": "{{IMAGEN_ESTILO}}" }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": { "image": ["4", 0], "upscale_method": "lanczos", "width": "{{ANCHO}}", "height": "{{ALTO}}", "crop": "disabled" }
  },
  "7": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["5", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["6", 0], "vae": ["3", 0] }
  },
  "9": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["7", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" }
  },
  "11": {
    "class_type": "ReferenceLatent",
    "_meta": { "title": "Referencia 1 (esquema)" },
    "inputs": { "conditioning": ["10", 0], "latent": ["8", 0] }
  },
  "12": {
    "class_type": "ReferenceLatent",
    "_meta": { "title": "Referencia 2 (estilo)" },
    "inputs": { "conditioning": ["11", 0], "latent": ["9", 0] }
  },
  "13": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["12", 0] }
  },
  "14": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{{SEMILLA}}" }
  },
  "15": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "16": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 4, "width": "{{ANCHO}}", "height": "{{ALTO}}" }
  },
  "17": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": { "title": "Tamaño" },
    "inputs": { "width": "{{ANCHO}}", "height": "{{ALTO}}", "batch_size": 1 }
  },
  "18": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["14", 0], "guider": ["13", 0], "sampler": ["15", 0], "sigmas": ["16", 0], "latent_image": ["17", 0] }
  },
  "19": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["18", 0], "vae": ["3", 0] }
  },
  "20": {
    "class_type": "SaveImage",
    "_meta": { "title": "Salida" },
    "inputs": { "images": ["19", 0], "filename_prefix": "{{PREFIJO}}" }
  }
}
